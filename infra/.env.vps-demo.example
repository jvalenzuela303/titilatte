# =============================================================================
# Minimarket Demo — Variables de entorno VPS (demo.s3suite.cl)
# Copiar a .env.vps-demo y completar los valores reales.
# NUNCA commitear .env.vps-demo al repositorio.
# =============================================================================

# ---- Base de datos (minimarket_db en s3suite-postgres) ----
POSTGRES_DB=minimarket_db
POSTGRES_USER=minimarket_user
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_SEGURO

# ---- JWT ----
# Generar con: openssl rand -base64 48
JWT_SECRET=CAMBIAR_JWT_SECRET_MINIMO_32_CHARS
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000

# ---- CORS ----
CORS_ALLOWED_ORIGINS=https://demo.s3suite.cl

# ---- Spring profile ----
SPRING_PROFILES_ACTIVE=demo

# ---- JVM ----
JAVA_OPTS="-Xms128m -Xmx400m -XX:+UseG1GC -XX:MaxGCPauseMillis=200"

# ---- Logging ----
LOG_LEVEL=WARN
